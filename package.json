{
  "name": "start-metric-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "description": "SaaS para Gestão de Tráfego e Tracking de Vendas",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "painel": "npm run dev --workspace=start-metric",
    "start": "npm run start --workspace=start-metric",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "turbo run test"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "prettier": "latest",
    "turbo": "latest"
  }
}
